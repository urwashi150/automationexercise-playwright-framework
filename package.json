{
  "name": "automationexercise-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript automation framework for automationexercise.com (UI + API)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test --project=api tests/api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "ci:ui": "playwright test tests/ui",
    "ci:api": "playwright test --project=api tests/api",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://automationexercise.com"
  },
  "keywords": ["playwright", "typescript", "automation", "qa", "sdet"],
  "author": "Urwashi",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
